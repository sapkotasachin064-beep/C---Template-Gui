{
    "version": 4,
    "configurations": [
        {
            "name": "Win32-MSVC",
            "includePath": [
                "${workspaceFolder}/**",
                "$(VC_IncludePath)",
                "$(WindowsSDK_IncludePath)"
            ],
            "defines": [
                "UNICODE",
                "_UNICODE",
                "WIN32_LEAN_AND_MEAN",
                "NOMINMAX"
            ],
            "compilerPath": "cl.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-msvc-x64",
            "windowsSdkVersion": "10.0.22000.0"
        }
    ]
}
