{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build KellUI",
            "type": "shell",
            "command": "cl",
            "args": [
                "/std:c++17",
                "/EHsc",
                "/DUNICODE",
                "/D_UNICODE",
                "/Fe:${workspaceFolder}\\build\\KellUI.exe",
                "${workspaceFolder}\\KellUI.cpp",
                "/link",
                "/SUBSYSTEM:WINDOWS",
                "d2d1.lib",
                "dwrite.lib",
                "dwmapi.lib",
                "user32.lib",
                "gdi32.lib"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"],
            "detail": "Build KellUI Direct2D menu"
        },
